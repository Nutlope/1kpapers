{
  "name": "year-in-ai-papers",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "pnpm site:build",
    "benchmark": "tsx src/benchmark.ts",
    "calibration": "tsx src/calibration.ts",
    "calibration:check": "tsx src/validate-calibration.ts",
    "corpus": "tsx src/discover.ts",
    "download": "tsx src/download.ts",
    "dev": "pnpm site:dev",
    "full": "tsx src/full.ts",
    "full-report": "tsx src/full-report.ts",
    "judge": "tsx src/judge.ts",
    "pilot": "tsx src/pilot.ts",
    "quality": "tsx src/quality-report.ts",
    "range": "tsx src/range.ts",
    "merge": "tsx src/merge-results.ts",
    "report": "tsx src/report.ts",
    "storage:sync": "node --env-file=.env --import tsx src/sync-site-storage.ts",
    "site:build": "pnpm --dir site build",
    "site:dev": "pnpm --dir site dev",
    "site:typecheck": "pnpm --dir site typecheck",
    "test": "node --import tsx --test src/*.test.ts",
    "together-batch": "tsx src/together-batch.ts",
    "typecheck": "tsc --noEmit && pnpm site:typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "fast-xml-parser": "^5.10.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
